# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the publishable key (sb_publishable_...) or the legacy "anon public" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# --- Phase 2: PDF import AI ---------------------------------------------
# Which AI reads the PDFs: anthropic (default) | openai | basic (no AI, clean tables only)
AI_PROVIDER=anthropic
# Anthropic Claude (console.anthropic.com → API Keys). Server-side only — never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high
# OpenAI (only if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# --- Phase 3: follow-up notifications (Web Push) ------------------------
# Generate a key pair once:  npx web-push generate-vapid-keys
# The PUBLIC key is also exposed to the browser via NEXT_PUBLIC_VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret used by the 15-minute cron job (any long random string). Send it as
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Service-role key for the cron job only (Supabase → Project Settings → API).
# Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: time zone for "today" / follow-up dates (default Asia/Kolkata).
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
